# Development runtime. Never put real credentials in this file.
NODE_ENV=development
CLINIC_DB=data/clinic.sqlite
DEMO_MODE=off
CLINIC_DEMO=
CLINIC_DEMO_ONLY=
DATABASE_URL=
CLINIC_POSTGRES_SCHEMA=
# Set 1 for full clinic-wide serialization rollback; otherwise converted mutations use row locks.
CLINIC_POSTGRES_GLOBAL_LOCK=
VERCEL=
# Production bootstrap, scheduler and authenticated proxy forwarding (random secrets).
CLINIC_SETUP_TOKEN=
CLINIC_AUTOMATION_SECRET=
CLINIC_REMINDER_LEAD_MINUTES=
CLINIC_TRUSTED_PROXY_TOKEN=
CLINIC_BASE_URL=
# Optional provider-neutral HTTPS email adapter; invitations need an approved lifetime.
CLINIC_EMAIL_ENDPOINT=
CLINIC_EMAIL_KEY=
CLINIC_INVITATION_TTL_MINUTES=
# Scanning disabled until a local ClamAV Unix socket is configured. Downloads stay quarantined.
CLINIC_CLAMAV_SOCKET=
# Optional operator-controlled transport module and explicitly approved retry policy.
CLINIC_OUTBOX_TRANSPORT=
CLINIC_OUTBOX_MAX_ATTEMPTS=
CLINIC_OUTBOX_BASE_DELAY_MS=
CLINIC_OUTBOX_MAX_DELAY_MS=
CLINIC_OUTBOX_BATCH_SIZE=
# Legacy SQLite/dev backup key and optional independently anchored audit head.
CLINIC_BACKUP_KEY=
CLINIC_AUDIT_EXPECTED_HEAD=
# Synthetic-only tests and browser artifacts; never point these at production.
CLINIC_TEST_POSTGRES=
CLINIC_UI_DATABASE_URL=
CLINIC_UI_ARTIFACTS=
CLINIC_UI_WIDTH=
CLINIC_UI_HEIGHT=
CLINIC_UI_SKIP_VISUAL=
CHROME_PATH=
CLINIC_ACCEPTANCE_BASE=
CLINIC_ACCEPTANCE_REAL=
CLINIC_AUDIT_MATRIX=
CLINIC_SECURITY_ACCEPTANCE=
CLINIC_ASSETS_ACCEPTANCE=
CLINIC_COMPLETION_ACCEPTANCE=
CLINIC_TEST_NODEMAILER=
# Shared infra operator variables live outside Git, not in application .env.local.
CONFIG_DIR=
PROJECTS_DIR=
BACKUP_RETENTION_DAYS=
BACKUP_OFFSITE_HOOK=
POSTGRES_DRILL_IMAGE=

# Optional separate mail-adapter service (private operator file, never client variables).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Deployment orchestration only; owner/operator must choose immutable release tags.
RELEASE_TAG=
PREVIOUS_RELEASE_TAG=
MIGRATIONS_BACKWARD_COMPATIBLE=
